generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AlertLevel {
  BAJO
  MEDIO
  ALTO
}

enum VideoStatus {
  CARGADO
  VALIDANDO
  VALIDO
  INVALIDO
  PROCESANDO
  FINALIZADO
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  age          Int?
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  videos       VideoMarcha[]
  analyses     GaitAnalysis[]
  reports      MedicalReport[]
}

model VideoMarcha {
  id                       String      @id @default(cuid())
  userId                   String
  originalName             String
  storedName               String?
  url                      String?
  mimeType                 String
  sizeBytes                Int
  validationStatus         VideoStatus @default(CARGADO)
  originalVideoUrl         String?
  originalVideoPublicId    String?
  processedVideoUrl        String?
  processedVideoPublicId   String?
  localOriginalVideoUrl    String?
  localProcessedVideoUrl   String?
  videoProvider            String      @default("local")
  originalFileName         String?
  processedFileName        String?
  cloudinaryOriginalBytes  Int?
  cloudinaryProcessedBytes Int?
  cloudinaryOriginalFormat String?
  cloudinaryProcessedFormat String?
  createdAt                DateTime    @default(now())

  user                     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses                 GaitAnalysis[]
  posePoints               PosePoint[]
}

model PosePoint {
  id            String @id @default(cuid())
  videoId       String
  frameNumber   Int
  bodyPoint     String
  x             Float
  y             Float
  z             Float?

  video         VideoMarcha @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model GaitAnalysis {
  id        String     @id @default(cuid())
  userId    String
  videoId   String
  alert     AlertLevel
  summary   String
  createdAt DateTime   @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  video      VideoMarcha @relation(fields: [videoId], references: [id], onDelete: Cascade)

  parameters GaitParameter[]
  signals    DetectedSignal[]
  conditions AssociatedCondition[]
  report     MedicalReport?
}

model GaitParameter {
  id          String @id @default(cuid())
  analysisId String
  name        String
  value       String
  state       String
  description String?

  analysis    GaitAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model DetectedSignal {
  id          String     @id @default(cuid())
  analysisId String
  name        String
  relevance   AlertLevel
  description String

  analysis    GaitAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model AssociatedCondition {
  id          String @id @default(cuid())
  analysisId String
  condition   String
  status      String
  description String

  analysis    GaitAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model MedicalReport {
  id         String   @id @default(cuid())
  userId     String
  analysisId String   @unique
  title      String
  pdfUrl     String?
  createdAt  DateTime @default(now())

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis   GaitAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model SystemLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  detail    String?
  createdAt DateTime @default(now())
}
